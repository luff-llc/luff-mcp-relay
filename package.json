{
  "name": "ligature-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm test --workspaces",
    "build": "npm run build --workspace=@luff-llc/ligature",
    "typecheck": "npm run typecheck --workspace=@luff-llc/ligature",
    "dev": "npm run dev --workspace=@luff-llc/ligature",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:public": "node scripts/audit-public.mjs",
    "check": "npm test && npm run build && npm run verify:packages && npm run verify:public",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "typescript": "5.8.3",
    "wrangler": "4.151.0",
    "ws": "8.22.0"
  },
  "license": "MIT"
}
